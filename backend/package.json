{
  "name": "fastrev-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "eslint . --ext .ts",
    "typecheck": "tsc --noEmit",
    "test": "jest --detectOpenHandles --forceExit",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "db:seed": "ts-node prisma/seed.ts",
    "worker": "ts-node-dev --respawn --transpile-only src/worker/notification.worker.ts"
  },
  "dependencies": {
    "express": "^4.21.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "dotenv": "^16.4.5",
    "zod": "^3.23.8",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-rate-limit": "^7.2.0",
    "axios": "^1.7.2",
    "bullmq": "^5.17.0",
    "ioredis": "^5.3.2",
    "pino": "^9.3.0",
    "pino-http": "^9.0.0",
    "@prisma/client": "^5.18.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/uuid": "^9.0.8",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^2.0.16",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.0",
    "prisma": "^5.18.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.4",
    "supertest": "^6.3.4",
    "eslint": "^9.10.0",
    "@typescript-eslint/parser": "^8.8.0",
    "@typescript-eslint/eslint-plugin": "^8.8.0"
  }
}
