PORT=4000
NODE_ENV=development
DATABASE_URL="mysql://fastrev:fastrev_password@localhost:3306/fastrev"
JWT_SECRET=change_me_to_a_long_random_secret_do_not_use_in_production
JWT_EXPIRY=24h
CORS_ORIGIN=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
AI_PREDICT_TIMEOUT_MS=3000
REDIS_URL=redis://localhost:6379
SMS_PROVIDER=console
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOG_LEVEL=info

# Optional bootstrap clinic admin (set both or neither; password >= 8 chars)
BOOTSTRAP_ADMIN_EMAIL=admin@fastrev.clinic
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123!

# Dedicated integration test DB only (must use fastrev_test user & db on localhost)
# FASTREV_TEST_DATABASE_URL="mysql://fastrev_test:fastrev_test@localhost:3306/fastrev_test"
