{
  "name": "fastrev-workers",
  "version": "1.0.0",
  "private": true,
  "description": "FastRev Redis + BullMQ background workers for appointment reminders and AI prediction retries",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
