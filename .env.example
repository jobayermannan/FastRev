# ==============================================================================
# FastRev — Root Environment Configuration (Docker Compose & Multi-Service)
# Copy to `.env` and replace placeholder secrets before running.
# ==============================================================================

# --- MySQL 8 Database ---
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
MYSQL_DATABASE=fastrev
MYSQL_USER=fastrev
MYSQL_PASSWORD=change_me_mysql_user_password

# Internal Compose DB URL (for host-side CLI use localhost:3306 instead of mysql:3306)
DATABASE_URL="mysql://fastrev:change_me_mysql_user_password@mysql:3306/fastrev"

# --- Redis & BullMQ Queues ---
REDIS_URL=redis://redis:6379

# --- Python AI Prediction Microservice ---
AI_SERVICE_URL=http://ai-service:8000
AI_PREDICT_TIMEOUT_MS=3000
MODEL_PATH=/app/models/no_show_model.joblib

# --- Backend Auth & Security ---
JWT_SECRET=change_me_to_at_least_32_random_characters_in_prod
JWT_EXPIRY=24h
CORS_ORIGIN=http://localhost:3000

# Optional: First clinic admin bootstrapped idempotently at server startup
BOOTSTRAP_ADMIN_EMAIL=admin@fastrev.clinic
BOOTSTRAP_ADMIN_PASSWORD=ChangeMeAdmin123!

# --- Notification Worker ---
SMS_PROVIDER=console

# --- Next.js Frontend (Browser-Facing API Base URL) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
